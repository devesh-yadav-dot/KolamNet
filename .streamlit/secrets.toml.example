# Copy to .streamlit/secrets.toml for local runs (that file is git-ignored),
# or paste these keys into  App settings -> Secrets  on Streamlit Community Cloud.
#
# OPTIONAL. If omitted, visitors enter their own key in the sidebar.
# WARNING: setting this on a public app lets anyone spend YOUR quota.
# GEMINI_API_KEY = "your-key-here"

# OPTIONAL. Override the model without touching code.
# GEMINI_MODEL = "gemini-3.6-flash"
